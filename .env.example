# =====================================================================
# RDx Road Project Control — production environment (VPS / Docker)
# Copy to ".env" and fill every value:  cp .env.example .env
# NEVER commit the real .env to git.
# =====================================================================

# ---- App ----
# Public URL of the site (no trailing slash). Used for OAuth callbacks/links.
APP_BASE_URL=https://erp.yourdomain.com
# Random long secret for session cookies. Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# ---- MySQL ----
# Option A (VPS docker-compose): the compose file creates MySQL for you.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=rdx
MYSQL_USER=rdx
MYSQL_PASSWORD=change-me-dbpass
# Option B (free tier): TiDB Cloud Serverless — free, MySQL-compatible.
# https://tidbcloud.com -> create cluster -> Connect -> copy connection string:
#   DATABASE_URL=mysql://<user>:<password>@<host>:4000/rdx
# and set DB_SSL=true (TiDB requires TLS).
# NOTE: if your password contains @ : / ? # characters, URL-encode them.
DB_SSL=false

# ---- Google login (Firebase) ----
# Firebase Console (https://console.firebase.google.com) -> your project ->
# Project Settings -> "Your apps" (web app) -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# First user to sign in with this email becomes admin automatically.
GOOGLE_ADMIN_EMAIL=you@example.com
# (Optional, only if you also use server-side Google OAuth directly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- File storage ----
# Default backend: Firebase Cloud Storage (free 5 GB on the Spark plan,
# NO card needed). Set:
#   STORAGE_BACKEND=firebase
#   VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app  (above)
#   FIREBASE_SERVICE_ACCOUNT_JSON=<service-account JSON, raw or base64>
# Generate the key free: Firebase console -> Project settings ->
# Service accounts -> Generate new private key.
STORAGE_BACKEND=firebase
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative backend: S3-compatible (AWS S3 / Cloudflare R2).
# Set STORAGE_BACKEND=s3 and fill these (R2 dashboard -> R2 -> bucket + token):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=rdx-uploads
#   S3_ACCESS_KEY_ID=
#   S3_SECRET_ACCESS_KEY=
#   S3_PUBLIC_URL=https://pub-xxx.r2.dev   (bucket Settings -> Public access)
#   S3_FORCE_PATH_STYLE=true
